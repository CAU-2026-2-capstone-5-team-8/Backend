# Local-only configuration. Copy to .env and set a generated password.
# Keep values compatible with both Java properties and Docker Compose.
POSTGRES_DB=backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SERVER_PORT=8080
ML_MODE=stub
# Deployment: SPRING_PROFILES_ACTIVE=production, APP_AUTH_MODE=required,
# ML_MODE=http and an explicit ML_BASE_URL are mandatory together.
APP_AUTH_TRUSTED_PROXY_CIDRS=
